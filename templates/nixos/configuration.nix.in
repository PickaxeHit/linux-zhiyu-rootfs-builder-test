{
  config,
  lib,
  pkgs,
  ...
}:
let
  lock = builtins.fromJSON (builtins.readFile ./flake.lock);
  bsp = lock.nodes.${lock.nodes.${lock.root}.inputs.zhiyu};
  zhiyu = builtins.getFlake "github:${bsp.locked.owner}/${bsp.locked.repo}/${bsp.locked.rev}";
  toolchain = lock.nodes.${bsp.inputs.nixpkgs}.locked;
in
{
  imports = [ zhiyu.nixosModules.default ];
  nixpkgs.hostPlatform = "aarch64-linux";
  nixpkgs.flake = {
    setFlakeRegistry = false;
    setNixPath = false;
  };
  system.nixos = {
    inherit (zhiyu.inputs.nixpkgs.lib.trivial) versionSuffix;
    revision = toolchain.rev;
  };
  zhiyu.enable = true;
  # The BSP initramfs mounts the writable root and passes it to stage 2.
  # Leave / out of fstab so systemd keeps that mount and its existing options.
  networking.hostName = @HOSTNAME@;
  networking.networkmanager.enable = true;
  system.stateVersion = "26.05";

  nix.settings.experimental-features = [
    "nix-command"
    "flakes"
  ];
  nix.channel.enable = false;
  # Make the traditional rebuild use the same pinned nixpkgs as the Flake.
  nix.registry.nixpkgs.to = {
    type = "github";
    inherit (toolchain) owner repo rev;
  };
  nix.nixPath = [
    "nixpkgs=flake:nixpkgs"
    "nixos-config=/etc/nixos/configuration.nix"
  ];
  nix.settings.nix-path = config.nix.nixPath;

  # Preserve the password initialized in /etc/shadow when the system activates.
  users.mutableUsers = true;
  users.users = {
    root.hashedPassword = "!";
    @USERNAME@ = {
      isNormalUser = true;
      extraGroups = [
        "wheel"
        "networkmanager"
        "video"
      ];
      initialHashedPassword = "!";
    };
  };
  services.openssh = {
    enable = true;
    authorizedKeysFiles = [ "/etc/ssh/authorized_keys.d/%u" ];
    settings = {
      PasswordAuthentication = false;
      KbdInteractiveAuthentication = false;
      PermitRootLogin = "no";
    };
  };
  environment.systemPackages = [ pkgs.git ];
@DESKTOP@
}
