{
  config,
  lib,
  pkgs,
  ...
}:
let
  lock = builtins.fromJSON (builtins.readFile ./flake.lock);
  bsp = lock.nodes.${lock.nodes.${lock.root}.inputs.zhiyu};
  zhiyu = builtins.getFlake "github:${bsp.locked.owner}/${bsp.locked.repo}/${bsp.locked.rev}";
  toolchain = lock.nodes.${bsp.inputs.nixpkgs}.locked;
  upstreamCamera = pkgs.libcamera;
  zhiyuCamera = zhiyu.packages.aarch64-linux.libcamera;
  # The runtime rewriter requires equal-length store basenames.
  cameraReplacement = pkgs.runCommand upstreamCamera.name { } ''
    for lib in libcamera libcamera-base; do
      test -e "${zhiyuCamera}/lib/$lib.so.${upstreamCamera.version}"
    done
    ln -s ${zhiyuCamera} "$out"
  '';
in
{
  imports = [ zhiyu.nixosModules.default ];
  nixpkgs.hostPlatform = "aarch64-linux";
  nixpkgs.flake = {
    setFlakeRegistry = false;
    setNixPath = false;
  };
  system.nixos = {
    inherit (zhiyu.inputs.nixpkgs.lib.trivial) versionSuffix;
    revision = toolchain.rev;
  };
  zhiyu.enable = true;
  # Keep nixpkgs consumers on their original derivations until the closure is assembled.
  zhiyu.camera.enable = false;
  system.replaceDependencies.replacements = [
    {
      oldDependency = upstreamCamera;
      newDependency = cameraReplacement;
    }
  ];
  # The BSP initramfs mounts the writable root and passes it to stage 2.
  # Leave / out of fstab so systemd keeps that mount and its existing options.
  networking.hostName = @HOSTNAME@;
  networking.networkmanager.enable = true;
  system.stateVersion = "26.05";

  nix.settings.experimental-features = [
    "nix-command"
    "flakes"
  ];
  nix.channel.enable = false;
  # Make the traditional rebuild use the same pinned nixpkgs as the Flake.
  nix.registry.nixpkgs.to = {
    type = "github";
    inherit (toolchain) owner repo rev;
  };
  nix.nixPath = [
    "nixpkgs=flake:nixpkgs"
    "nixos-config=/etc/nixos/configuration.nix"
  ];
  nix.settings.nix-path = config.nix.nixPath;

  # Read the initial hash from the deployed filesystem during activation.
  users.users = {
    root.hashedPassword = "!";
    @USERNAME@ = {
      isNormalUser = true;
      extraGroups = [
        "wheel"
        "networkmanager"
        "video"
      ];
      initialHashedPassword = "!";
      hashedPasswordFile = "/var/lib/zhiyu/initial-password.hash";
    };
  };
  services.openssh = {
    enable = true;
    authorizedKeysFiles = [ "/etc/ssh/authorized_keys.d/%u" ];
    settings = {
      PasswordAuthentication = false;
      KbdInteractiveAuthentication = false;
      PermitRootLogin = "no";
    };
  };
  environment.systemPackages = [
    pkgs.git
    upstreamCamera
  ];

  # The official system tarball contains Nix validity registrations. Load
  # them before store consumers, and keep the file on disk if import fails.
  systemd.services.zhiyu-register-store = {
    description = "Register the deployed Nix store closure";
    wantedBy = [ "sysinit.target" ];
    after = [ "local-fs.target" ];
    before = [
      "sysinit.target"
      "shutdown.target"
      "nix-daemon.service"
      "nix-daemon.socket"
    ];
    conflicts = [ "shutdown.target" ];
    unitConfig = {
      DefaultDependencies = false;
      ConditionPathExists = "/nix-path-registration";
    };
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      ${lib.getExe' config.nix.package "nix-store"} --load-db < /nix-path-registration
      ${pkgs.coreutils}/bin/rm /nix-path-registration
    '';
  };
  systemd.services.nix-daemon = {
    requires = [ "zhiyu-register-store.service" ];
    after = [ "zhiyu-register-store.service" ];
  };
@DESKTOP@
}
